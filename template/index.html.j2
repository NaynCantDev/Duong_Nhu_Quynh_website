{% extends "_base.html.j2" %}
{% block title %}Giới thiệu{% endblock %}
{% block content %}
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <div class="chip reveal">🎼 {{ major }}{% if school %} · {{ school }}{% endif %}</div>
      <h1 class="hero-name reveal" data-delay="1">Xin chào, mình là<br><span class="gradient-text script">{{ name }}</span></h1>
      <p class="hero-bio reveal" data-delay="2"><span class="typed" data-text="{{ short_bio }}">{{ short_bio }}</span><span class="caret"></span></p>
      <div class="hero-actions reveal" data-delay="3">
        <a href="projects.html" class="btn btn-primary magnetic">♫ Xem 6 bài tập <span class="arrow">→</span></a>
        <a href="#about" class="btn btn-ghost magnetic">Về mình</a>
      </div>
    </div>

    <div class="hero-visual reveal" data-delay="2">
      <div class="vinyl-wrap">
        <div class="vinyl">
          <div class="vinyl-label{{ ' has-photo' if avatar_url }}">{% if avatar_url %}<img src="{{ avatar_url }}" alt="Ảnh của {{ name }}">{% else %}{{ avatar_emoji }}{% endif %}</div>
        </div>
        <div class="tonearm" aria-hidden="true"></div>
      </div>
      <div class="equalizer" aria-hidden="true">
        {% for i in range(18) %}<span style="--i:{{ i }}"></span>{% endfor %}
      </div>
      <div class="float-tag t1">🎤 Thanh nhạc</div>
      <div class="float-tag t2">🎹 Nhạc cụ</div>
      <div class="float-tag t3">📚 Sư phạm</div>
    </div>
  </div>

  <div class="staff-band" aria-hidden="true">
    <div class="staff-track">
      {% for n in '♪♫♩♬♪♫♬♩♪♫♩♬♪♫♬♩♪♫♩♬♪♫♬♩' %}<span class="sn" style="--h:{{ loop.index0 * 37 % 5 }}">{{ n }}</span>{% endfor %}
    </div>
  </div>
  <a href="#about" class="scroll-hint" aria-label="Cuộn xuống"><span></span></a>
</section>

<section id="about" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-label">♪ 01 — About Me</span>
      <h2 class="section-title">Giới thiệu bản thân</h2>
    </div>

    <div class="bento">
      <article class="card glass tilt reveal wide">
        <div class="card-icon">👋</div>
        <h3>Về mình</h3>
        <p>{{ about.intro }}</p>
        <div class="chips">
          <span class="chip sm">🎓 {{ major }}</span>
          {% if student_id %}<span class="chip sm">🪪 {{ student_id }}</span>{% endif %}
          {% if class %}<span class="chip sm">🏫 {{ class }}</span>{% endif %}
        </div>
      </article>
      <article class="card glass tilt reveal accent-rasp" data-delay="1">
        <div class="card-icon">🎤</div>
        <h3>Sở thích</h3>
        <p class="big">{{ about.hobbies }}</p>
        <div class="mini-eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </article>
      <article class="card glass reveal full">
        <div class="card-icon">🎯</div>
        <h3>Mục tiêu học tập</h3>
        <p>{{ about.learning_goal }}</p>
      </article>
      {% if about.development %}
      <article class="card glass reveal wide">
        <div class="card-icon">🌱</div>
        <h3>Phát triển &amp; định hướng cá nhân</h3>
        <p>{{ about.development }}</p>
      </article>
      {% endif %}
      <article class="card glass tilt reveal accent-teal" data-delay="1">
        <div class="card-icon">🗂️</div>
        <h3>Mục tiêu Portfolio</h3>
        <p>{{ about.portfolio_goal }}</p>
      </article>
    </div>
  </div>
</section>

<section class="section cta-band">
  <div class="container">
    <div class="cta-box glass reveal">
      <div class="cta-notes" aria-hidden="true">♪ ♫ ♬</div>
      <h2>Hành trình 6 chương học phần</h2>
      <p class="muted">Mỗi bài tập là một nốt nhạc — ghép lại thành một bản nhạc hoàn chỉnh.</p>
      <a href="projects.html" class="btn btn-primary magnetic">Khám phá dự án <span class="arrow">→</span></a>
    </div>
  </div>
</section>
{% endblock %}
