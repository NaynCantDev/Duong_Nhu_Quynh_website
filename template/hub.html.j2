<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio CNS&amp;AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/style.css">
</head>
<body class="page-hub">
<div class="bg" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div><div class="grid-overlay"></div></div>
<div class="spotlight" aria-hidden="true"></div>
<section class="page-hero">
  <div class="container">
    <span class="section-label reveal">Danh sách</span>
    <h1 class="page-title reveal" data-delay="1">Portfolio <span class="gradient-text">CNS&amp;AI</span></h1>
    <p class="page-sub reveal" data-delay="2">Chọn một portfolio để xem.</p>
  </div>
</section>
<section class="section pt-0">
  <div class="container project-grid">
    {% for s in students %}
    <a href="{{ s.slug }}/index.html" class="pcard glass tilt reveal" data-delay="{{ loop.index0 % 3 }}">
      <div class="pcard-top"><span class="pnum">{{ s.avatar_emoji }}</span><span class="pscore">{{ s.total_score }} / {{ s.max_score }}</span></div>
      <div class="pchapter">{{ s.student_id }} · {{ s.class }}</div>
      <h3 class="ptitle">{{ s.name }}</h3>
      <p class="pdesc">{{ s.short_bio }}</p>
      <div class="pfoot"><span class="ptool">{{ s.major }}</span><span class="pgo">Mở <span class="arrow">→</span></span></div>
    </a>
    {% endfor %}
  </div>
</section>
<script src="assets/main.js"></script>
</body>
</html>
